# Public application identity. Values prefixed with NEXT_PUBLIC_ may reach the browser.
NEXT_PUBLIC_APP_NAME=NIFTY Intelligence Terminal
NEXT_PUBLIC_APP_ENV=development
# Development only: direct loopback backend. Do not set in the Worker build.
# Production uses the same-origin Worker gateway with MARKET_API_* Worker secrets.
NEXT_PUBLIC_MARKET_API_URL=http://127.0.0.1:8000

# Backend-only application configuration.
APP_NAME=NIFTY Intelligence Terminal
APP_ENV=development
LOG_LEVEL=INFO
API_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5173
API_AUTH_MODE=disabled
# Production only: generate a random value of at least 32 characters and keep it server-side.
API_AUTH_TOKEN=
REQUEST_BODY_LIMIT_BYTES=65536
REQUESTS_PER_MINUTE=120
WEBSOCKET_CONNECTION_LIMIT=5

# Use replay until the Angel One verifier passes locally.
MARKET_DATA_MODE=replay
MARKET_DATA_PROVIDER=

# Angel One credentials are backend-only. Fill these in .env, never in this template.
# ANGELONE_TOTP_SECRET is the Base32 key shown with the SmartAPI TOTP QR code.
# It is NOT the API app secret key and it is NOT the current six-digit TOTP.
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# NIFTY 50 index identifiers. 99926000 is the current instrument-master token.
# Keep these configurable because provider token semantics can change independently.
ANGELONE_NIFTY_WEBSOCKET_TOKEN=99926000
ANGELONE_NIFTY_HISTORICAL_TOKEN=99926000
# Step 18C research context. Verify these against the current Angel One
# instrument master before acquisition; the CLI also reports the exact tokens used.
ANGELONE_BANKNIFTY_HISTORICAL_TOKEN=99926009
ANGELONE_INDIA_VIX_HISTORICAL_TOKEN=99926017
ANGELONE_WEBSOCKET_EXCHANGE_TYPE=1
ANGELONE_PRICE_SCALE=100
ANGELONE_CONNECT_TIMEOUT_SECONDS=20
ANGELONE_STREAM_QUEUE_CAPACITY=4096

# Continuous live-runtime behavior. Official inference remains 5m-finalized only.
LIVE_HISTORY_LOOKBACK_DAYS=14
LIVE_HISTORY_RECOVERY_MINUTES=15
LIVE_HISTORY_POLL_SECONDS=10
LIVE_MINUTE_FINALIZATION_DELAY_SECONDS=5
LIVE_TICK_FRESH_SECONDS=3
LIVE_TICK_STALE_SECONDS=15
LIVE_CHART_PUBLISH_INTERVAL_MILLISECONDS=250
LIVE_CHART_HISTORY_PRIMARY_LIMIT=750
LIVE_CHART_HISTORY_CONTEXT_LIMIT=250
LIVE_CHART_HISTORY_HOURLY_LIMIT=120

# Live signals stay disabled until every release gate passes. Keep true by default.
LIVE_SIGNAL_KILL_SWITCH=true
RELEASE_MANIFEST_PATH=
MODEL_ARTIFACT_PATH=
CALIBRATION_ARTIFACT_PATH=

# Optional research-only shadow inference. Step 17 prints the manifest path.
# Shadow mode records hidden predictions/outcomes; it never enables official signals.
SHADOW_MODE_ENABLED=false
SHADOW_RUNTIME_MANIFEST_PATH=
SHADOW_LEDGER_PATH=data/shadow-ledger.sqlite3

# Never add real provider credentials to this example file.
# Provider tokens, API_AUTH_TOKEN, and artifact paths are server-only. Never prefix them NEXT_PUBLIC_.
