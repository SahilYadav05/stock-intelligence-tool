{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candle.v1",
  "title": "Canonical Candle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candle_id", "instrument_id", "timeframe", "opens_at",
    "closes_at", "open", "high", "low", "close", "volume", "status",
    "revision", "source", "provider", "source_revision", "finalized_at",
    "component_candle_ids", "source_watermark", "supersedes_candle_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candle_id": { "type": "string", "format": "uuid" },
    "instrument_id": { "type": "string", "minLength": 1 },
    "timeframe": { "enum": ["1m", "5m", "15m", "1h"] },
    "opens_at": { "type": "string", "format": "date-time" },
    "closes_at": { "type": "string", "format": "date-time" },
    "open": { "$ref": "#/$defs/decimal" },
    "high": { "$ref": "#/$defs/decimal" },
    "low": { "$ref": "#/$defs/decimal" },
    "close": { "$ref": "#/$defs/decimal" },
    "volume": { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
    "status": { "enum": ["DEVELOPING", "FINALIZED"] },
    "revision": { "type": "integer", "minimum": 1 },
    "source": { "enum": ["PROVISIONAL_EVENTS", "AUTHORITATIVE_MINUTE", "AGGREGATED"] },
    "provider": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "integer", "minimum": 1 },
    "finalized_at": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "component_candle_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "source_watermark": { "type": "string", "minLength": 1 },
    "supersedes_candle_id": {
      "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
  }
}
