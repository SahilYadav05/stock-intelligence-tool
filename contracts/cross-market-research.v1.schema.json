{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-intelligence.local/contracts/cross-market-research.v1.schema.json",
  "title": "Cross-market model research report",
  "type": "object",
  "required": [
    "schema_version",
    "step18c_version",
    "dataset_id",
    "context_bundle_sha256",
    "controlled_comparison",
    "research_gate",
    "model_artifact_created",
    "approved_for_live_inference",
    "precise_probability_display_allowed",
    "official_signal_available",
    "automatic_trading_enabled"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "step18c_version": {"const": "cross_market_model_research.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "context_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "controlled_comparison": {"type": "object"},
    "research_gate": {"type": "object"},
    "model_artifact_created": {"const": false},
    "approved_for_live_inference": {"const": false},
    "precise_probability_display_allowed": {"const": false},
    "official_signal_available": {"const": false},
    "automatic_trading_enabled": {"const": false}
  },
  "additionalProperties": true
}
