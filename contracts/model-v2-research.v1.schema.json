{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-intelligence.local/contracts/model-v2-research.v1.schema.json",
  "title": "Step 18 Hierarchical Model V2 Research Report",
  "type": "object",
  "required": [
    "schema_version",
    "step18_version",
    "dataset_id",
    "experiment_id",
    "feature_architecture",
    "candidate_comparison",
    "selected_candidate",
    "calibration_comparison",
    "historical_diagnostic",
    "forward_confirmation",
    "existing_step17_runtime_modified",
    "model_artifact_created",
    "approved_for_live_inference",
    "precise_probability_display_allowed",
    "official_signal_available",
    "automatic_trading_enabled"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "step18_version": { "const": "hierarchical_model_v2_research.v1" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "existing_step17_runtime_modified": { "const": false },
    "model_artifact_created": { "const": false },
    "approved_for_live_inference": { "const": false },
    "precise_probability_display_allowed": { "const": false },
    "official_signal_available": { "const": false },
    "automatic_trading_enabled": { "const": false }
  }
}
