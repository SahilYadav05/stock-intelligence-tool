{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider-health.v1",
  "title": "Provider Health v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "connection_state",
    "observed_at",
    "last_event_time",
    "detail"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "connection_state": {
      "enum": [
        "DISCONNECTED",
        "CONNECTING",
        "RECOVERING",
        "LIVE",
        "DELAYED",
        "STALE",
        "MARKET_CLOSED"
      ]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "last_event_time": { "type": ["string", "null"], "format": "date-time" },
    "detail": { "type": ["string", "null"] }
  }
}
