{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-intelligence.local/contracts/ranked-utility-research.v1.schema.json",
  "title": "Ranked utility cohort research report",
  "type": "object",
  "required": [
    "schema_version",
    "step18e_version",
    "dataset_id",
    "context_bundle_sha256",
    "objective",
    "selected_models",
    "utility_diagnostics",
    "historical_simulated_live_replay",
    "research_gate",
    "model_artifact_created",
    "approved_for_live_inference",
    "precise_probability_display_allowed",
    "official_signal_available",
    "automatic_trading_enabled"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "step18e_version": {"const": "ranked_utility_cohort_research.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "context_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objective": {"type": "object"},
    "selected_models": {"type": "object"},
    "utility_diagnostics": {"type": "object"},
    "historical_simulated_live_replay": {"type": "object"},
    "research_gate": {"type": "object"},
    "model_artifact_created": {"const": false},
    "approved_for_live_inference": {"const": false},
    "precise_probability_display_allowed": {"const": false},
    "official_signal_available": {"const": false},
    "automatic_trading_enabled": {"const": false}
  },
  "additionalProperties": true
}
