{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "websocket-message.v1",
  "title": "Market WebSocket Message v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_type", "sequence", "sent_at",
    "instrument_id", "payload"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "message_type": { "enum": ["MARKET_STATE", "STATUS"] },
    "sequence": { "type": "integer", "minimum": 0 },
    "sent_at": { "type": "string", "format": "date-time" },
    "instrument_id": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  }
}
